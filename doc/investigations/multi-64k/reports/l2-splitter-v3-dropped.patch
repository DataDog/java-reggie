+package com.datadoghq.reggie.codegen.codegen;
+
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.MethodTooLargeException;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.MethodNode;
+
+/**
+ * {@link ClassVisitor} that transparently keeps every emitted method below the JVM's 65,535-byte
+ * per-method limit — layer 2 of the method-size strategy (see {@code
+ * doc/plans/method-size-splitting.md}).
+ *
+ * <p>Wraps the real {@link ClassWriter} (which stays the terminal pipeline stage and the {@code
+ * toByteArray()} producer). Each splittable method is buffered into an ASM tree {@link MethodNode};
+ * at {@code visitMaxs} the buffer decides: a conservative size bound that fits is replayed
+ * verbatim; otherwise an exact scratch-writer probe runs, and only if that also overflows does
+ * {@link MethodSplitter} rewrite the method as a chain of physical methods (chunk 0 keeps the
+ * original header, so call sites, annotations, and the structural cache are unaffected).
+ *
+ * <p>Every failure mode (cannot be safely split, analysis refuses) replays the method verbatim: a
+ * genuinely oversized method then throws {@link MethodTooLargeException} from the real writer
+ * exactly as before, so callers keep their existing fallback handling. Constructors, static
+ * initializers, and methods containing monitor instructions are never split.
+ *
+ * <p>Both compilation paths (runtime {@code RuntimeCompiler} and compile-time {@code
+ * ReggieMatcherBytecodeGenerator}) insert this visitor in front of their writer; the bytecode
+ * generators' parameters are typed {@link ClassVisitor} for this reason.
+ */
+public class SplittingClassVisitor extends ClassVisitor implements Opcodes {
+  private final ClassWriter realWriter;
+  private String internalName;
+
+  public SplittingClassVisitor(ClassWriter realWriter) {
+    super(ASM9, realWriter);
+    this.realWriter = realWriter;
+  }
+
+  @Override
+  public void visit(
+      int version,
+      int access,
+      String name,
+      String signature,
+      String superName,
+      String[] interfaces) {
+    this.internalName = name;
+    super.visit(version, access, name, signature, superName, interfaces);
+  }
+
+  @Override
+  public MethodVisitor visitMethod(
+      int access, String name, String descriptor, String signature, String[] exceptions) {
+    if (!MethodSplitter.isSplittableHeader(access, name)) {
+      return super.visitMethod(access, name, descriptor, signature, exceptions);
+    }
+    return new BufferedMethod(access, name, descriptor, signature, exceptions);
+  }
+
+  private final class BufferedMethod extends MethodNode {
+    private final int access;
+    private final String name;
+    private final String descriptor;
+    private final String signature;
+    private final String[] exceptions;
+    private boolean flushed;
+
+    BufferedMethod(
+        int access, String name, String descriptor, String signature, String[] exceptions) {
+      super(ASM9, access, name, descriptor, signature, exceptions);
+      this.access = access;
+      this.name = name;
+      this.descriptor = descriptor;
+      this.signature = signature;
+      this.exceptions = exceptions;
+    }
+
+    @Override
+    public void visitMaxs(int maxStack, int maxLocals) {
+      super.visitMaxs(maxStack, maxLocals);
+      flush();
+    }
+
+    @Override
+    public void visitEnd() {
+      super.visitEnd();
+      flush();
+    }
+
+    private void flush() {
+      if (flushed) {
+        return;
+      }
+      flushed = true;
+      if (maxStack < 0) {
+        maxStack = 0; // defensive: generator violated the visitor contract; writer recomputes
+      }
+      if (maxLocals < 0) {
+        maxLocals = 0;
+      }
+      MethodVisitor real = realWriter.visitMethod(access, name, descriptor, signature, exceptions);
+      if (MethodSplitter.conservativeCodeSize(this) > MethodSplitter.MAX_CODE_SIZE
+          && !probeFits()
+          && MethodSplitter.trySplit(this, internalName, realWriter, real)) {
+        return; // split: chunk 0 + chunk methods emitted
+      }
+      // Fits, probe fits, or the splitter declined: replay verbatim. If the method really is
+      // oversized, this throws MethodTooLargeException — exactly today's behavior, which callers
+      // already route to their fallback.
+      accept(real);
+    }
+
+    /**
+     * Exact size probe: replays the buffered method into a scratch writer (fresh labels, so the
+     * buffer's labels stay unbound) and catches {@link MethodTooLargeException}. The scratch pool
+     * may index constants differently than the real pool, so the probe can be off by ±1 byte per
+     * {@code ldc} instruction; the real writer remains the final guard.
+     */
+    private boolean probeFits() {
+      try {
+        ClassWriter scratch = new ClassWriter(0);
+        scratch.visit(V21, ACC_PUBLIC, "reggie/SplitProbe", null, "java/lang/Object", null);
+        MethodVisitor mv = scratch.visitMethod(access, name, descriptor, null, exceptions);
+        MethodSplitter.emitVerbatimInto(mv, this);
+        scratch.visitEnd();
+        // The size check fires at class serialization (toByteArray), NOT at visitMaxs —
+        // verified empirically against ASM 9.10.1.
+        scratch.toByteArray();
+        return true;
+      } catch (MethodTooLargeException e) {
+        return false;
+      }
+    }
+  }
+}
