+import org.objectweb.asm.Label;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+
+/**
+ * End-to-end tests for the layer-2 method-size splitter ({@link SplittingClassVisitor} + {@link
+ * MethodSplitter}, see {@code doc/plans/method-size-splitting.md}). Each test generates a class
+ * through the splitting pipeline, loads it (which runs the JVM verifier against recomputed frames),
+ * and checks behavior plus the emitted method set.
+ */
+class SplittingClassVisitorTest implements Opcodes {
+  private static final String CLASS_INTERNAL_NAME = "SplittingTestSubject";
+  private static final String CLASS_JAVA_NAME = "SplittingTestSubject";
+
+  private static final class TestClassLoader extends ClassLoader {
+    Class<?> defineClass(String name, byte[] bytecode) {
+      return defineClass(name, bytecode, 0, bytecode.length);
+    }
+  }
+
+  /** Builds a class with one static method {@code compute} whose body is given by {@code body}. */
+  private static byte[] buildClass(String methodDescriptor, Consumer<MethodVisitor> body) {
+    return buildClass(methodDescriptor, 64, 64, body);
+  }
+
+  /**
+   * Builds a class with one static method {@code compute} with caller-declared maxima — 0/0 is
+   * legal for a {@code COMPUTE_MAXS} writer and is what every real generator streams (~230 {@code
+   * visitMaxs(0, 0)} call sites).
+   */
+  private static byte[] buildClass(
+      String methodDescriptor,
+      int declaredMaxStack,
+      int declaredMaxLocals,
+      Consumer<MethodVisitor> body) {
+    ClassWriter realWriter = new ClassWriter(ClassWriter.COMPUTE_FRAMES | ClassWriter.COMPUTE_MAXS);
+    ClassVisitor front = new SplittingClassVisitor(realWriter);
+    front.visit(V21, ACC_PUBLIC | ACC_SUPER, CLASS_INTERNAL_NAME, null, "java/lang/Object", null);
+    MethodVisitor mv =
+        front.visitMethod(ACC_PUBLIC | ACC_STATIC, "compute", methodDescriptor, null, null);
+    mv.visitCode();
+    body.accept(mv);
+    mv.visitMaxs(declaredMaxStack, declaredMaxLocals); // recomputed by COMPUTE_MAXS
+    mv.visitEnd();
+    front.visitEnd();
+    return realWriter.toByteArray();
+  }
+
+  private static int invokeInt(byte[] bytecode, Object... args) throws Exception {
+    Class<?> cls = new TestClassLoader().defineClass(CLASS_JAVA_NAME, bytecode);
+    Method method = cls.getMethod("compute", argTypes(args));
+    return (Integer) method.invoke(null, args);
+  }
+
+  private static long invokeLong(byte[] bytecode, Object... args) throws Exception {
+    Class<?> cls = new TestClassLoader().defineClass(CLASS_JAVA_NAME, bytecode);
+    Method method = cls.getMethod("compute", argTypes(args));
+    return (Long) method.invoke(null, args);
+  }
+
+  private static Class<?>[] argTypes(Object... args) {
+    Class<?>[] types = new Class<?>[args.length];
+    for (int i = 0; i < args.length; i++) {
+      Object o = args[i];
+      types[i] =
+          o instanceof Integer
+              ? int.class
+              : o instanceof Long ? long.class : o.getClass(); // reflect primitives as primitives
+    }
+    return types;
+  }
+
+  /** Method names of the produced class, in emission order. */
+  private static List<String> methodNames(byte[] bytecode) {
+    List<String> names = new ArrayList<>();
+    new ClassReader(bytecode)
+        .accept(
+            new ClassVisitor(Opcodes.ASM9) {
+              @Override
+              public MethodVisitor visitMethod(
+                  int access,
+                  String name,
+                  String descriptor,
+                  String signature,
+                  String[] exceptions) {
+                names.add(name);
+                return null;
+              }
+            },
+            0);
+    return names;
+  }
+
+  /** A method that fits is replayed verbatim: exactly one method, same behavior. */
+  @Test
+  void fitsReplaysVerbatim() throws Exception {
+    byte[] bytes =
+        buildClass(
+            "()I",
+            mv -> {
+              BytecodeUtil.pushInt(mv, 40);
+              BytecodeUtil.pushInt(mv, 2);
+              mv.visitInsn(IADD);
+              mv.visitInsn(IRETURN);
+            });
+    assertEquals(List.of("compute"), methodNames(bytes));
+    assertEquals(42, invokeInt(bytes));
+  }
+
+  /**
+   * ~72 KB of straight-line accumulation overflows the 64 KB limit: the method is split into chunks
+   * (slot 0 is a live non-parameter local at every cut, so every chunk entry receives it as an
+   * extra int parameter) and still computes the exact sum.
+   */
+  @Test
+  void splitsOversizedStraightLineMethod() throws Exception {
+    int n = 12_000;
+    byte[] bytes =
+        buildClass(
+            "()I",
+            mv -> {
+              mv.visitInsn(ICONST_0);
+              mv.visitVarInsn(ISTORE, 0);
+              for (int k = 1; k <= n; k++) {
+                mv.visitVarInsn(ILOAD, 0);
+                BytecodeUtil.pushInt(mv, k);
+                mv.visitInsn(IADD);
+                mv.visitVarInsn(ISTORE, 0);
+              }
+              mv.visitVarInsn(ILOAD, 0);
+              mv.visitInsn(IRETURN);
+            });
+    List<String> names = methodNames(bytes);
+    assertTrue(names.size() > 1, "expected chunk methods, got: " + names);
+    assertTrue(names.get(0).equals("compute"), "chunk 0 must keep the original name");
+    assertTrue(names.stream().filter(nm -> nm.startsWith("compute$s")).count() >= 1);
+    // toByteArray succeeded => every emitted method is under the 64 KB limit (MethodWriter
+    // throws MethodTooLargeException otherwise).
+    assertEquals(n * (n + 1) / 2, invokeInt(bytes));
+  }
+
+  /**
+   * Regression: generators streaming into {@code COMPUTE_MAXS} writers legally declare {@code
+   * visitMaxs(0, 0)} — the buffered node must repair those zeros before analysis, or ASM's Analyzer
+   * refuses at instruction 0 and every such method silently declines to verbatim (found via a
+   * 40k-char literal through {@code NFABytecodeGenerator.findLongestMatchEnd}).
+   */
+  @Test
+  void splitsOversizedMethodDeclaredWithZeroMaxes() throws Exception {
+    int n = 12_000;
+    byte[] bytes =
+        buildClass(
+            "()I",
+            0,
+            0,
+            mv -> {
+              mv.visitInsn(ICONST_0);
+              mv.visitVarInsn(ISTORE, 0);
+              for (int k = 1; k <= n; k++) {
+                mv.visitVarInsn(ILOAD, 0);
+                BytecodeUtil.pushInt(mv, k);
+                mv.visitInsn(IADD);
+                mv.visitVarInsn(ISTORE, 0);
+              }
+              mv.visitVarInsn(ILOAD, 0);
+              mv.visitInsn(IRETURN);
+            });
+    List<String> names = methodNames(bytes);
+    assertTrue(names.size() > 1, "expected chunk methods, got: " + names);
+    assertTrue(names.stream().filter(nm -> nm.startsWith("compute$s")).count() >= 1);
+    assertEquals(n * (n + 1) / 2, invokeInt(bytes));
+  }
+
+  /**
+   * Regression: live params alongside a live non-param local at a cut. The extras collection must
+   * not short-circuit when the first live slot is a param — dropped extras would emit chunks whose
+   * signatures miss the accumulator (VerifyError or silent miscompilation).
+   */
+  @Test
+  void splitsWithLiveParamsAndLocalAcrossCut() throws Exception {
+    int n = 12_000;
+    byte[] bytes =
+        buildClass(
+            "(II)J",
+            mv -> {
+              mv.visitInsn(LCONST_0);
+              mv.visitVarInsn(LSTORE, 2); // long acc (slots 2-3)
+              for (int k = 1; k <= n; k++) {
+                mv.visitVarInsn(LLOAD, 2); // acc
+                mv.visitVarInsn(ILOAD, 0); // a — live across cuts
+                BytecodeUtil.pushInt(mv, k);
+                mv.visitInsn(IMUL);
+                mv.visitInsn(I2L);
+                mv.visitInsn(LADD);
+                mv.visitVarInsn(ILOAD, 1); // b — live across cuts
+                mv.visitInsn(I2L);
+                mv.visitInsn(LADD); // acc += a*k + b
+                mv.visitVarInsn(LSTORE, 2);
+              }
+              mv.visitVarInsn(LLOAD, 2);
+              mv.visitInsn(LRETURN);
+            });
+    List<String> names = methodNames(bytes);
+    assertTrue(names.size() > 1, "expected chunk methods, got: " + names);
+    assertEquals(2L * (n * (n + 1) / 2) + 3L * n, invokeLong(bytes, 2, 3));
+  }
+
+  /**
+   * A live reference local ("abc") spanning every cut: its ASTORE sources must be unmasked to the
+   * LDC's {@code Ljava/lang/String;} type for the chunk parameters to verify.
+   */
+  @Test
+  void splitsWithLiveReferenceLocal() throws Exception {
+    int n = 7_000;
+    byte[] bytes =
+        buildClass(
+            "()I",
+            mv -> {
+              mv.visitLdcInsn("abc");
+              mv.visitVarInsn(ASTORE, 0); // String s (slot 0)
+              mv.visitInsn(ICONST_0);
+              mv.visitVarInsn(ISTORE, 1); // int acc (slot 1)
+              for (int k = 1; k <= n; k++) {
+                mv.visitVarInsn(ALOAD, 0);
+                mv.visitMethodInsn(INVOKEVIRTUAL, "java/lang/String", "length", "()I", false);
+                BytecodeUtil.pushInt(mv, k);
+                mv.visitInsn(IADD); // s.length() + k
+                mv.visitVarInsn(ILOAD, 1);
+                mv.visitInsn(IADD);
+                mv.visitVarInsn(ISTORE, 1);
+              }
+              mv.visitVarInsn(ILOAD, 1);
+              mv.visitInsn(IRETURN);
+            });
+    assertTrue(methodNames(bytes).size() > 1, "expected the method to be split");
+    assertEquals("abc".length() * n + n * (n + 1) / 2, invokeInt(bytes));
+  }
+
+  /** Forward if/else branches crossing chunk boundaries become call+return blocks. */
+  @Test
+  void splitsWithForwardCrossingBranches() throws Exception {
+    int n = 6_001;
+    byte[] bytes =
+        buildClass(
+            "()I",
+            mv -> {
+              mv.visitInsn(ICONST_0);
+              mv.visitVarInsn(ISTORE, 0); // a (even accumulator)
+              mv.visitInsn(ICONST_0);
+              mv.visitVarInsn(ISTORE, 1); // b (odd accumulator)
+              for (int k = 1; k <= n; k++) {
+                BytecodeUtil.pushInt(mv, k);
+                mv.visitInsn(ICONST_1);
+                mv.visitInsn(IAND);
+                Label elseLabel = new Label();
+                mv.visitJumpInsn(IFEQ, elseLabel);
+                mv.visitVarInsn(ILOAD, 0);
+                BytecodeUtil.pushInt(mv, 2);
+                mv.visitInsn(IADD);
+                mv.visitVarInsn(ISTORE, 0);
+                Label endLabel = new Label();
+                mv.visitJumpInsn(GOTO, endLabel);
+                mv.visitLabel(elseLabel);
+                mv.visitVarInsn(ILOAD, 1);
+                BytecodeUtil.pushInt(mv, 3);
+                mv.visitInsn(IADD);
+                mv.visitVarInsn(ISTORE, 1);
+                mv.visitLabel(endLabel);
+              }
+              mv.visitVarInsn(ILOAD, 0);
+              BytecodeUtil.pushInt(mv, 1_000);
+              mv.visitInsn(IMUL);
+              mv.visitVarInsn(ILOAD, 1);
+              mv.visitInsn(IADD);
+              mv.visitInsn(IRETURN);
+            });
+    assertTrue(methodNames(bytes).size() > 1, "expected the method to be split");
+    // ifeq jumps on k&1 == 0, so even k take the else (b += 3) branch and odd k fall through (a +=
+    // 2).
+    int evens = n / 2;
+    int odds = n - evens;
+    assertEquals(2 * odds * 1_000 + 3 * evens, invokeInt(bytes));
+  }
+
+  /**
+   * A try region and its handler must stay whole inside one chunk, with cuts only before and after
+   * the protected span; both the normal and the exceptional path must produce exact results.
+   */
+  @Test
+  void tryRegionStaysWholeAndBothPathsBehave() throws Exception {
+    int pre = 5_000;
+    int post = 6_000;
+    int preSum = pre * (pre + 1) / 2;
+    int postSum = post * (post + 1) / 2;
+    byte[] bytes =
+        buildClass(
+            "(Z)I",
+            mv -> {
+              mv.visitInsn(ICONST_0);
+              mv.visitVarInsn(ISTORE, 1); // acc (slot 1; slot 0 is the boolean parameter)
+              for (int k = 1; k <= pre; k++) {
+                mv.visitVarInsn(ILOAD, 1);
+                BytecodeUtil.pushInt(mv, k);
+                mv.visitInsn(IADD);
+                mv.visitVarInsn(ISTORE, 1);
+              }
+              Label tryStart = new Label();
+              Label tryEnd = new Label();
+              Label handler = new Label();
+              Label tryExit = new Label();
+              mv.visitTryCatchBlock(tryStart, tryEnd, handler, "java/lang/RuntimeException");
+              mv.visitLabel(tryStart);
+              mv.visitVarInsn(ILOAD, 1);
+              BytecodeUtil.pushInt(mv, 77);
+              mv.visitInsn(IADD);
+              mv.visitVarInsn(ISTORE, 1);
+              mv.visitVarInsn(ILOAD, 0);
+              Label noThrow = new Label();
+              mv.visitJumpInsn(IFEQ, noThrow);
+              mv.visitTypeInsn(NEW, "java/lang/RuntimeException");
+              mv.visitInsn(DUP);
+              mv.visitLdcInsn("boom");
+              mv.visitMethodInsn(
+                  INVOKESPECIAL,
+                  "java/lang/RuntimeException",
+                  "<init>",
+                  "(Ljava/lang/String;)V",
+                  false);
+              mv.visitInsn(ATHROW);
+              mv.visitLabel(noThrow);
+              mv.visitLabel(tryEnd);
+              mv.visitJumpInsn(GOTO, tryExit);
+              mv.visitLabel(handler);
+              mv.visitVarInsn(ASTORE, 2); // exception
+              BytecodeUtil.pushInt(mv, -999);
+              mv.visitVarInsn(ISTORE, 1); // acc = -999 (the pre-try value is replaced)
+              mv.visitLabel(tryExit);
+              for (int k = 1; k <= post; k++) {
+                mv.visitVarInsn(ILOAD, 1);
+                BytecodeUtil.pushInt(mv, k);
+                mv.visitInsn(IADD);
+                mv.visitVarInsn(ISTORE, 1);
+              }
+              mv.visitVarInsn(ILOAD, 1);
+              mv.visitInsn(IRETURN);
+            });
+    List<String> names = methodNames(bytes);
+    assertTrue(names.size() > 1, "expected the method to be split");
+    Class<?> cls = new TestClassLoader().defineClass(CLASS_JAVA_NAME, bytes);
+    Method compute = cls.getMethod("compute", boolean.class);
+    assertEquals(preSum + 77 + postSum, compute.invoke(null, false));
+    assertEquals(-999 + postSum, compute.invoke(null, true));
+  }
+
+  /**
+   * An oversized loop body crossed by its back edge has no legal cut: the splitter declines, the
+   * method is replayed verbatim, and the real writer throws {@code MethodTooLargeException} —
+   * exactly today's pre-splitter behavior, which callers route to their fallback.
+   */
+  @Test
+  void declinesToSplitLoopBodyAndPreservesTodayBehavior() {
+    int statements = 20_000; // ~80 KB — well over the 64 KB limit
+    assertThrows(
+        org.objectweb.asm.MethodTooLargeException.class,
+        () ->
+            buildClass(
+                "()I",
+                mv -> {
+                  mv.visitInsn(ICONST_0);
+                  mv.visitVarInsn(ISTORE, 0); // i
+                  mv.visitInsn(ICONST_0);
+                  mv.visitVarInsn(ISTORE, 1); // sum
+                  Label head = new Label();
+                  Label done = new Label();
+                  mv.visitLabel(head);
+                  mv.visitVarInsn(ILOAD, 0);
+                  mv.visitInsn(ICONST_1);
+                  mv.visitJumpInsn(IF_ICMPGE, done);
+                  for (int k = 0; k < statements; k++) {
+                    mv.visitVarInsn(ILOAD, 1);
+                    mv.visitInsn(ICONST_1);
+                    mv.visitInsn(IADD);
+                    mv.visitVarInsn(ISTORE, 1);
+                  }
+                  mv.visitIincInsn(0, 1);
+                  mv.visitJumpInsn(GOTO, head);
+                  mv.visitLabel(done);
+                  mv.visitVarInsn(ILOAD, 1);
+                  mv.visitInsn(IRETURN);
+                }));
+  }
+}
