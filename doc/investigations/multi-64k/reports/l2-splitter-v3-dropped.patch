+package com.datadoghq.reggie.codegen.codegen;
+
+import java.util.List;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.Type;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.IntInsnNode;
+import org.objectweb.asm.tree.InvokeDynamicInsnNode;
+import org.objectweb.asm.tree.LdcInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MultiANewArrayInsnNode;
+import org.objectweb.asm.tree.TryCatchBlockNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+import org.objectweb.asm.tree.analysis.AnalyzerException;
+import org.objectweb.asm.tree.analysis.Frame;
+import org.objectweb.asm.tree.analysis.Interpreter;
+
+/**
+ * Lightweight type-checking bytecode interpreter used by {@link MethodSplitter}: every abstract
+ * value is a plain type descriptor string (or {@link #UNKNOWN} when a value's type cannot be
+ * established — null constants, uninitialized locals, or values reaching a control-flow merge with
+ * differing descriptors).
+ *
+ * <p>Unlike ASM's {@link org.objectweb.asm.tree.analysis.SourceInterpreter}, which attributes
+ * values to growing sets of producing instructions and degrades quadratically on loop-carried
+ * locals, this interpreter carries a single descriptor per value, so merges are O(1) and linear in
+ * method size. Unlike {@link org.objectweb.asm.tree.analysis.SimpleVerifier}, it never loads
+ * classes: merges of differing reference types become {@link #UNKNOWN}, and the splitter rejects
+ * cut points where an {@link #UNKNOWN} slot is live — conservative and sound (the original verifier
+ * proved those uses type-check, but the exact merged type is not reconstructible without a class
+ * hierarchy).
+ *
+ * <p>Copy operations ({@code xstore}/{@code xload}) propagate the operand's descriptor unchanged,
+ * so a local's type at any program point is directly available for chunk-parameter typing.
+ */
+final class DescriptorInterpreter extends Interpreter<DescriptorInterpreter.DV> implements Opcodes {
+  /** A type whose descriptor could not be established. */
+  static final DV UNKNOWN = new DV(null);
+
+  /** An abstract value: a type descriptor, or null for {@link #UNKNOWN}. */
+  static final class DV implements org.objectweb.asm.tree.analysis.Value {
+    final String desc;
+
+    DV(String desc) {
+      this.desc = desc;
+    }
+
+    @Override
+    public int getSize() {
+      if (desc == null) {
+        return 1;
+      }
+      char c = desc.charAt(0);
+      return (c == 'J' || c == 'D') ? 2 : 1;
+    }
+  }
+
+  DescriptorInterpreter() {
+    super(ASM9);
+  }
+
+  private static DV dv(String desc) {
+    return new DV(desc);
+  }
+
+  @Override
+  public DV newValue(Type type) {
+    if (type == null) {
+      return UNKNOWN;
+    }
+    return dv(type.getDescriptor());
+  }
+
+  @Override
+  public DV newParameterValue(boolean isInstanceMethod, int local, Type type) {
+    return dv(type.getDescriptor());
+  }
+
+  @Override
+  public DV newReturnTypeValue(Type type) {
+    return dv(type.getDescriptor());
+  }
+
+  @Override
+  public DV newEmptyValue(int local) {
+    return UNKNOWN; // uninitialized local
+  }
+
+  @Override
+  public DV newExceptionValue(
+      TryCatchBlockNode tryCatchBlock, Frame<DV> handlerFrame, Type exceptionType) {
+    return dv(exceptionType.getDescriptor());
+  }
+
+  @Override
+  public DV newOperation(AbstractInsnNode insn) throws AnalyzerException {
+    switch (insn.getOpcode()) {
+      case ACONST_NULL -> {
+        return UNKNOWN; // null: not soundly typeable as a chunk parameter
+      }
+      case ICONST_M1,
+          ICONST_0,
+          ICONST_1,
+          ICONST_2,
+          ICONST_3,
+          ICONST_4,
+          ICONST_5,
+          BIPUSH,
+          SIPUSH -> {
+        return dv("I");
+      }
+      case LCONST_0, LCONST_1 -> {
+        return dv("J");
+      }
+      case FCONST_0, FCONST_1, FCONST_2 -> {
+        return dv("F");
+      }
+      case DCONST_0, DCONST_1 -> {
+        return dv("D");
+      }
+      case GETSTATIC -> {
+        return dv(((FieldInsnNode) insn).desc);
+      }
+      case NEW -> {
+        return dv(((TypeInsnNode) insn).desc);
+      }
+      default -> {
+        if (insn instanceof LdcInsnNode ldc) {
+          return ldv(ldc.cst);
+        }
+        return UNKNOWN;
+      }
+    }
+  }
+
+  private static DV ldv(Object constant) {
+    if (constant instanceof Integer) {
+      return dv("I");
+    }
+    if (constant instanceof Long) {
+      return dv("J");
+    }
+    if (constant instanceof Float) {
+      return dv("F");
+    }
+    if (constant instanceof Double) {
+      return dv("D");
+    }
+    if (constant instanceof String) {
+      return dv("Ljava/lang/String;");
+    }
+    if (constant instanceof Type) {
+      return dv("Ljava/lang/Class;");
+    }
+    if (constant instanceof org.objectweb.asm.Handle) {
+      return dv("Ljava/lang/invoke/MethodHandle;");
+    }
+    if (constant instanceof org.objectweb.asm.ConstantDynamic cd) {
+      return dv(cd.getDescriptor());
+    }
+    return UNKNOWN;
+  }
+
+  @Override
+  public DV copyOperation(AbstractInsnNode insn, DV value) throws AnalyzerException {
+    return value; // xload/xstore keep the value's descriptor
+  }
+
+  @Override
+  public DV unaryOperation(AbstractInsnNode insn, DV value) throws AnalyzerException {
+    switch (insn.getOpcode()) {
+      case INEG, I2B, I2C, I2S, ARRAYLENGTH, INSTANCEOF -> {
+        return dv("I");
+      }
+      case LNEG, I2L -> {
+        return dv("J");
+      }
+      case FNEG, I2F -> {
+        return dv("F");
+      }
+      case DNEG, I2D -> {
+        return dv("D");
+      }
+      case L2I, F2I, D2I -> {
+        return dv("I");
+      }
+      case L2F, D2F -> {
+        return dv("F");
+      }
+      case L2D, F2D -> {
+        return dv("D");
+      }
+      case GETFIELD -> {
+        return dv(((FieldInsnNode) insn).desc);
+      }
+      case CHECKCAST -> {
+        return dv(((TypeInsnNode) insn).desc);
+      }
+      case NEWARRAY -> {
+        return dv("[" + primitiveArrayDesc(((IntInsnNode) insn).operand));
+      }
+      case ANEWARRAY -> {
+        return dv("[" + ((TypeInsnNode) insn).desc);
+      }
+      case IALOAD, BALOAD, CALOAD, SALOAD, FALOAD, LALOAD, DALOAD -> {
+        return dv(
+            Type.getDescriptor(
+                switch (insn.getOpcode()) {
+                  case FALOAD -> float.class;
+                  case LALOAD -> long.class;
+                  case DALOAD -> double.class;
+                  default -> int.class;
+                }));
+      }
+      case AALOAD -> {
+        String arrayDesc = value == null ? null : value.desc;
+        if (arrayDesc == null || arrayDesc.length() < 2 || arrayDesc.charAt(0) != '[') {
+          return UNKNOWN;
+        }
+        return dv(arrayDesc.substring(1));
+      }
+      default -> {
+        return UNKNOWN;
+      }
+    }
+  }
+
+  @Override
+  public DV binaryOperation(AbstractInsnNode insn, DV value1, DV value2) throws AnalyzerException {
+    return switch (insn.getOpcode()) {
+      case IADD, ISUB, IMUL, IDIV, IREM, ISHL, ISHR, IUSHR, IAND, IOR, IXOR -> dv("I");
+      case LADD, LSUB, LMUL, LDIV, LREM, LSHL, LSHR, LUSHR, LAND, LOR, LXOR -> dv("J");
+      case FADD, FSUB, FMUL, FDIV, FREM -> dv("F");
+      case DADD, DSUB, DMUL, DDIV, DREM -> dv("D");
+      case LCMP, FCMPL, FCMPG, DCMPL, DCMPG -> dv("I");
+      default -> UNKNOWN;
+    };
+  }
+
+  @Override
+  public DV ternaryOperation(AbstractInsnNode insn, DV value1, DV value2, DV value3)
+      throws AnalyzerException {
+    return null; // array stores produce no value
+  }
+
+  @Override
+  public DV naryOperation(AbstractInsnNode insn, List<? extends DV> values)
+      throws AnalyzerException {
+    int op = insn.getOpcode();
+    String desc;
+    if (op == MULTIANEWARRAY) {
+      desc = ((MultiANewArrayInsnNode) insn).desc;
+    } else if (op == INVOKEDYNAMIC) {
+      desc = ((InvokeDynamicInsnNode) insn).desc;
+    } else {
+      desc = ((MethodInsnNode) insn).desc;
+    }
+    String returnType = Type.getReturnType(desc).getDescriptor();
+    return returnType.equals("V") ? null : dv(returnType);
+  }
+
+  @Override
+  public void returnOperation(AbstractInsnNode insn, DV value, DV expected)
+      throws AnalyzerException {
+    // no validation: the splitter only needs value types, not verification
+  }
+
+  @Override
+  public DV merge(DV value1, DV value2) {
+    if (value1 == value2) {
+      return value1;
+    }
+    if (value1 == null || value2 == null || value1.desc == null || value2.desc == null) {
+      return UNKNOWN;
+    }
+    return value1.desc.equals(value2.desc) ? value1 : UNKNOWN;
+  }
+
+  private static String primitiveArrayDesc(int operand) {
+    return switch (operand) {
+      case 4 -> "Z"; // T_BOOLEAN
+      case 5 -> "C"; // T_CHAR
+      case 6 -> "F"; // T_FLOAT
+      case 7 -> "D"; // T_DOUBLE
+      case 8 -> "B"; // T_BYTE
+      case 9 -> "S"; // T_SHORT
+      case 10 -> "I"; // T_INT
+      case 11 -> "J"; // T_LONG
+      default -> "I";
+    };
+  }
+}
