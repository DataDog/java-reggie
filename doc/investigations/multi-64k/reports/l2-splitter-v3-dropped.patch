+package com.datadoghq.reggie.codegen.codegen;
+
+import java.util.ArrayList;
+import java.util.BitSet;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.Label;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.Type;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.FieldInsnNode;
+import org.objectweb.asm.tree.FrameNode;
+import org.objectweb.asm.tree.IincInsnNode;
+import org.objectweb.asm.tree.InsnNode;
+import org.objectweb.asm.tree.IntInsnNode;
+import org.objectweb.asm.tree.InvokeDynamicInsnNode;
+import org.objectweb.asm.tree.JumpInsnNode;
+import org.objectweb.asm.tree.LabelNode;
+import org.objectweb.asm.tree.LdcInsnNode;
+import org.objectweb.asm.tree.LineNumberNode;
+import org.objectweb.asm.tree.LookupSwitchInsnNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+import org.objectweb.asm.tree.MultiANewArrayInsnNode;
+import org.objectweb.asm.tree.TableSwitchInsnNode;
+import org.objectweb.asm.tree.TryCatchBlockNode;
+import org.objectweb.asm.tree.TypeInsnNode;
+import org.objectweb.asm.tree.VarInsnNode;
+import org.objectweb.asm.tree.analysis.Analyzer;
+import org.objectweb.asm.tree.analysis.AnalyzerException;
+import org.objectweb.asm.tree.analysis.Frame;
+
+/**
+ * Generic post-hoc method splitter — layer 2 of the method-size strategy (see {@code
+ * doc/plans/method-size-splitting.md}).
+ *
+ * <p>Rewrites one oversized logical method as a chain of physical methods: chunk 0 keeps the
+ * original header (name, descriptor, annotations, throws), subsequent private chunks are named
+ * {@code <original>$sK} and receive the original parameters plus the local slots that are live at
+ * their entry cut. Chaining is a direct call in tail position ({@code invoke} + matching {@code
+ * xreturn}), so early returns and throws are preserved exactly.
+ *
+ * <p>Every cut point satisfies all of: empty operand stack, no jump crosses the cut except forward
+ * jumps landing exactly on the next chunk's entry (emitted as call+return blocks), try regions and
+ * their handlers stay whole inside one chunk, no monitor instructions anywhere in the method, and
+ * every live non-parameter slot is unambiguously typeable from its reaching value sources ({@link
+ * DescriptorInterpreter}). Any failed precondition aborts the split — the caller then replays the
+ * method verbatim, reproducing today's {@code MethodTooLargeException} → JDK-fallback behavior.
+ *
+ * <p>This class is not thread-safe; one instance splits one method.
+ */
+final class MethodSplitter implements Opcodes {
+  static final int MAX_CODE_SIZE = 65535;
+
+  /**
+   * Conservative byte budget per chunk. Below the JVM limit by ~5 KB to absorb the chaining call
+   * sequences (parameter loads, invokes, returns) that splitting itself adds.
+   */
+  private static final int CHUNK_BUDGET = 60_000;
+
+  private static final int MAX_PARAM_SLOTS = 255;
+
+  /** Floor for the repaired maxStack of methods that declared visitMaxs(0, 0) (see analyze). */
+  private static final int REPAIRED_MAX_STACK_FLOOR = 64;
+
+  // ---- input state ----
+  private final MethodNode node;
+  private final String className;
+  private final ClassWriter realWriter; // emits chunks 1..K (chunk 0 uses the passed visitor)
+
+  // ---- analysis state ----
+  private AbstractInsnNode[] insns;
+  private int insnCount;
+  private Frame<DescriptorInterpreter.DV>[] frames;
+  private Map<AbstractInsnNode, Integer> insnIndex;
+  private Map<LabelNode, Integer> labelIndex;
+  private BitSet noCut;
+  private BitSet[] liveIn;
+  private int maxLocals;
+  private int paramSlots; // receiver + parameters, in local slots
+  private Type[] paramTypes; // argument types in descriptor order (no receiver)
+  private boolean isStatic;
+  private String returnDesc;
+  private int[] boundaries; // chunk starts, including 0 and insnCount
+  private List<List<Extra>> extrasPerChunk; // live extra slots at each chunk entry
+
+  /** A live local slot at a chunk entry, passed as an extra chunk parameter. */
+  private record Extra(int slot, String desc) {}
+
+  private record LocalCross(Label localLabel, int targetEntry) {}
+
+  private MethodSplitter(MethodNode node, String className, ClassWriter realWriter) {
+    this.node = node;
+    this.className = className;
+    this.realWriter = realWriter;
+  }
+
+  // --------------------------------------------------------------------------------------------
+  // Entry points
+  // --------------------------------------------------------------------------------------------
+
+  /**
+   * Returns false for {@code <init>}/{@code <clinit>} (never split) and abstract/native methods.
+   */
+  static boolean isSplittableHeader(int access, String name) {
+    if (name.equals("<init>") || name.equals("<clinit>")) {
+      return false;
+    }
+    return (access & (ACC_ABSTRACT | ACC_NATIVE)) == 0;
+  }
+
+  /**
+   * Replays a method into the given visitor using fresh labels, without any transformation. Used
+   * for the scratch-writer size probe: the original {@link MethodNode}'s labels stay unbound so the
+   * later verbatim replay (or split) can re-visit them safely.
+   */
+  static void emitVerbatimInto(MethodVisitor mv, MethodNode node) {
+    IdentityHashMap<LabelNode, Label> labels = new IdentityHashMap<>();
+    mv.visitCode();
+    if (node.tryCatchBlocks != null) {
+      for (TryCatchBlockNode tcb : node.tryCatchBlocks) {
+        mv.visitTryCatchBlock(
+            freshLabel(labels, tcb.start),
+            freshLabel(labels, tcb.end),
+            freshLabel(labels, tcb.handler),
+            tcb.type);
+      }
+    }
+    for (AbstractInsnNode insn : node.instructions) {
+      emitInsn(mv, insn, labels, IDENTITY_SLOT_MAP);
+    }
+    mv.visitMaxs(node.maxStack, node.maxLocals);
+    mv.visitEnd();
+  }
+
+  /**
+   * Attempts to split {@code node}. On success, chunk 0 has been emitted into {@code chunk0} and
+   * chunks 1..K into the class writer. On failure nothing has been emitted and the caller must
+   * replay the method verbatim (which preserves today's overflow behavior).
+   */
+  static boolean trySplit(
+      MethodNode node, String className, ClassWriter realWriter, MethodVisitor chunk0) {
+    MethodSplitter splitter = new MethodSplitter(node, className, realWriter);
+    return splitter.split(chunk0);
+  }
+
+  // --------------------------------------------------------------------------------------------
+  // Conservative size accounting
+  // --------------------------------------------------------------------------------------------
+
+  /**
+   * Upper bound on the bytecode bytes the given method will occupy: jumps are sized as their wide
+   * forms, switch padding is maximized, {@code ldc} as {@code ldc_w}. A method whose conservative
+   * size is ≤ {@link #MAX_CODE_SIZE} is guaranteed to fit — no probe needed.
+   */
+  static int conservativeCodeSize(MethodNode node) {
+    int total = 0;
+    for (AbstractInsnNode insn : node.instructions) {
+      total += conservativeSize(insn);
+    }
+    return total;
+  }
+
+  private static int conservativeVarSize(int var) {
+    if (var < 4) {
+      return 1;
+    }
+    return var < 256 ? 2 : 4; // xload_n / xload / wide xload
+  }
+
+  private static int conservativeSize(AbstractInsnNode insn) {
+    if (insn instanceof LabelNode || insn instanceof LineNumberNode || insn instanceof FrameNode) {
+      return 0;
+    }
+    int op = insn.getOpcode();
+    if (insn instanceof InsnNode) {
+      return 1;
+    }
+    if (insn instanceof IntInsnNode) {
+      return op == NEWARRAY ? 2 : 3; // bipush 2, sipush 3; newarray 2
+    }
+    if (insn instanceof VarInsnNode) {
+      return conservativeVarSize(((VarInsnNode) insn).var);
+    }
+    if (insn instanceof TypeInsnNode) {
+      return 3;
+    }
+    if (insn instanceof FieldInsnNode) {
+      return 3;
+    }
+    if (insn instanceof MethodInsnNode) {
+      return op == INVOKEINTERFACE ? 5 : 3;
+    }
+    if (insn instanceof InvokeDynamicInsnNode) {
+      return 5;
+    }
+    if (insn instanceof JumpInsnNode) {
+      return op == GOTO ? 5 : 6; // goto_w / wide conditional
+    }
+    if (insn instanceof LdcInsnNode) {
+      return 3; // ldc_w
+    }
+    if (insn instanceof IincInsnNode) {
+      return 6; // wide iinc
+    }
+    if (insn instanceof MultiANewArrayInsnNode) {
+      return 4;
+    }
+    if (insn instanceof TableSwitchInsnNode) {
+      return 17 + 4 * ((TableSwitchInsnNode) insn).labels.size();
+    }
+    if (insn instanceof LookupSwitchInsnNode) {
+      return 15 + 8 * ((LookupSwitchInsnNode) insn).labels.size();
+    }
+    return 8; // unknown: assume a wide form
+  }
+
+  // --------------------------------------------------------------------------------------------
+  // Split driver
+  // --------------------------------------------------------------------------------------------
+
+  private boolean split(MethodVisitor chunk0) {
+    if (refuseFastPaths()) {
+      return false;
+    }
+    if (!analyze()) {
+      return false;
+    }
+    if (!chooseCuts()) {
+      return false;
+    }
+    if (!validateChunks()) {
+      return false;
+    }
+    emitChunks(chunk0);
+    return true;
+  }
+
+  /**
+   * Refuses methods the splitter cannot safely touch: monitors, subroutines, annotation defaults,
+   * empty bodies.
+   */
+  private boolean refuseFastPaths() {
+    if (node.instructions.size() == 0) {
+      return true;
+    }
+    if (node.annotationDefault != null) {
+      return true; // annotation-type member methods: verbatim path replays them exactly
+    }
+    isStatic = (node.access & ACC_STATIC) != 0;
+    for (AbstractInsnNode insn : node.instructions) {
+      int op = insn.getOpcode();
+      if (op == MONITORENTER || op == MONITOREXIT || op == JSR || op == RET) {
+        return true; // monitors must pair within one method; subroutines are pre-V7 dead weight
+      }
+    }
+    Type returnType = Type.getReturnType(node.desc);
+    returnDesc = returnType.getDescriptor();
+    paramTypes = Type.getArgumentTypes(node.desc);
+    paramSlots = (isStatic ? 0 : 1);
+    for (Type t : paramTypes) {
+      paramSlots += t.getSize();
+    }
+    return false;
+  }
+
+  /** Runs the source-value analysis; returns false if ASM cannot analyze the method. */
+  private boolean analyze() {
+    insns = node.instructions.toArray();
+    insnCount = insns.length;
+    insnIndex = new IdentityHashMap<>(insnCount * 2);
+    labelIndex = new IdentityHashMap<>(insnCount * 2);
+    for (int i = 0; i < insnCount; i++) {
+      insnIndex.put(insns[i], i);
+      if (insns[i] instanceof LabelNode label) {
+        labelIndex.put(label, i);
+      }
+    }
+    maxLocals = Math.max(node.maxLocals, 1);
+    for (AbstractInsnNode insn : insns) {
+      int var = varAccessed(insn);
+      if (var >= 0 && var + 1 > maxLocals) {
+        maxLocals = var + 1;
+      }
+    }
+    maxLocals = Math.max(maxLocals, paramSlots);
+    // Generators stream into COMPUTE_MAXS writers and legally declare visitMaxs(0, 0) — every
+    // real generator does (~230 call sites). The buffered MethodNode then carries maxLocals = 0,
+    // and ASM's Analyzer sizes its initial Frame from node.maxLocals, refusing at instruction 0
+    // ("Trying to set an inexistant local variable"). Repair the declared maxima from the
+    // instruction scan before analyzing: the real writer recomputes both at serialization, so the
+    // repair affects this analysis only. If a repaired stack capacity is still too small
+    // (operand stack deeper than the floor in a method that declared zeros), the Analyzer
+    // throws and we decline to verbatim — never corrupt.
+    node.maxLocals = maxLocals;
+    node.maxStack = Math.max(node.maxStack, REPAIRED_MAX_STACK_FLOOR);
+    try {
+      Analyzer<DescriptorInterpreter.DV> analyzer = new Analyzer<>(new DescriptorInterpreter());
+      analyzer.analyze(className, node);
+      frames = analyzer.getFrames();
+    } catch (AnalyzerException e) {
+      return false;
+    }
+    if (frames.length != insnCount) {
+      return false; // defensive; should not happen
+    }
+    computeLiveness();
+    buildNoCutZones();
+    return true;
+  }
+
+  private static int varAccessed(AbstractInsnNode insn) {
+    if (insn instanceof VarInsnNode var) {
+      return var.var;
+    }
+    if (insn instanceof IincInsnNode inc) {
+      return inc.var;
+    }
+    return -1;
+  }
+
+  // --------------------------------------------------------------------------------------------
+  // Liveness (backward, slot-level, exception edges included)
+  // --------------------------------------------------------------------------------------------
+
+  private void computeLiveness() {
+    BitSet[] uses = new BitSet[insnCount];
+    BitSet[] defs = new BitSet[insnCount];
+    List<List<Integer>> succs = new ArrayList<>(insnCount);
+    List<List<Integer>> preds = new ArrayList<>(insnCount);
+    for (int i = 0; i < insnCount; i++) {
+      uses[i] = new BitSet(maxLocals);
+      defs[i] = new BitSet(maxLocals);
+      succs.add(new ArrayList<>(2));
+      preds.add(new ArrayList<>(2));
+    }
+    for (int i = 0; i < insnCount; i++) {
+      AbstractInsnNode insn = insns[i];
+      if (insn instanceof VarInsnNode var) {
+        if (var.getOpcode() < ISTORE) {
+          uses[i].set(var.var);
+        } else {
+          defs[i].set(var.var);
+        }
+      } else if (insn instanceof IincInsnNode inc) {
+        uses[i].set(inc.var);
+        defs[i].set(inc.var);
+      }
+      addSuccessors(i, succs);
+    }
+    for (int i = 0; i < insnCount; i++) {
+      for (int succ : succs.get(i)) {
+        preds.get(succ).add(i);
+      }
+    }
+    // Backward worklist dataflow.
+    liveIn = new BitSet[insnCount];
+    for (int i = 0; i < insnCount; i++) {
+      liveIn[i] = new BitSet(maxLocals);
+    }
+    int[] queue = new int[insnCount];
+    boolean[] queued = new boolean[insnCount];
+    int head = 0;
+    int tail = 0;
+    for (int i = insnCount - 1; i >= 0; i--) {
+      queue[tail++ % insnCount] = i;
+      queued[i] = true;
+    }
+    while (head != tail) {
+      int i = queue[head++ % insnCount];
+      queued[i] = false;
+      BitSet out = new BitSet(maxLocals);
+      for (int succ : succs.get(i)) {
+        out.or(liveIn[succ]);
+      }
+      out.andNot(defs[i]);
+      out.or(uses[i]);
+      if (!out.equals(liveIn[i])) {
+        liveIn[i] = out;
+        for (int pred : preds.get(i)) {
+          if (!queued[pred]) {
+            queue[tail++ % insnCount] = pred;
+            queued[pred] = true;
+          }
+        }
+      }
+    }
+  }
+
+  private void addSuccessors(int i, List<List<Integer>> succs) {
+    AbstractInsnNode insn = insns[i];
+    List<Integer> out = succs.get(i);
+    if (insn instanceof JumpInsnNode jump) {
+      out.add(labelIndex.get(jump.label));
+      if (insn.getOpcode() != GOTO && i + 1 < insnCount) {
+        out.add(i + 1); // conditional: fallthrough edge
+      }
+    } else if (insn instanceof TableSwitchInsnNode sw) {
+      out.add(labelIndex.get(sw.dflt));
+      for (LabelNode l : sw.labels) {
+        out.add(labelIndex.get(l));
+      }
+    } else if (insn instanceof LookupSwitchInsnNode sw) {
+      out.add(labelIndex.get(sw.dflt));
+      for (LabelNode l : sw.labels) {
+        out.add(labelIndex.get(l));
+      }
+    } else {
+      int op = insn.getOpcode();
+      boolean terminal =
+          (op >= IRETURN && op <= RETURN)
+              || op == ATHROW
+              || op == GOTO
+              || op == TABLESWITCH
+              || op == LOOKUPSWITCH;
+      if (!terminal && i + 1 < insnCount) {
+        out.add(i + 1);
+      }
+    }
+    // Exception edges: every instruction inside a protected region may jump to its handler.
+    if (node.tryCatchBlocks != null) {
+      for (TryCatchBlockNode tcb : node.tryCatchBlocks) {
+        int start = labelIndex.get(tcb.start);
+        int end = labelIndex.get(tcb.end);
+        if (i >= start && i < end) {
+          out.add(labelIndex.get(tcb.handler));
+        }
+      }
+    }
+  }
+
+  // --------------------------------------------------------------------------------------------
+  // No-cut zones: try/handler spans + jump-crossing intervals
+  // --------------------------------------------------------------------------------------------
+
+  private void buildNoCutZones() {
+    noCut = new BitSet(insnCount);
+    if (node.tryCatchBlocks != null) {
+      for (TryCatchBlockNode tcb : node.tryCatchBlocks) {
+        // The region [start, end) and the handler entry must share a chunk (the exception table
+        // is per-method). The handler BODY may spill into later chunks via normal tail chaining.
+        int start = labelIndex.get(tcb.start);
+        int end = labelIndex.get(tcb.end);
+        int handler = labelIndex.get(tcb.handler);
+        int lo = Math.min(start, handler);
+        int hi = Math.max(end - 1, handler);
+        if (hi >= lo) {
+          noCut.set(lo + 1, hi + 1); // cut positions strictly between the extremes split the triple
+        }
+      }
+    }
+    for (int i = 0; i < insnCount; i++) {
+      AbstractInsnNode insn = insns[i];
+      if (insn instanceof JumpInsnNode jump) {
+        forbidCrossing(i, labelIndex.get(jump.label));
+      } else if (insn instanceof TableSwitchInsnNode sw) {
+        forbidCrossing(i, labelIndex.get(sw.dflt));
+        for (LabelNode l : sw.labels) {
+          forbidCrossing(i, labelIndex.get(l));
+        }
+      } else if (insn instanceof LookupSwitchInsnNode sw) {
+        forbidCrossing(i, labelIndex.get(sw.dflt));
+        for (LabelNode l : sw.labels) {
+          forbidCrossing(i, labelIndex.get(l));
+        }
+      }
+    }
+  }
+
+  private void forbidCrossing(int from, int to) {
+    if (to > from) {
+      noCut.set(from + 1, to); // cut positions in (from, to) are forbidden
+    } else if (to < from) {
+      noCut.set(to + 1, from + 1); // backward edge: cuts in (to, from] are forbidden
+    }
+  }
+
+  // --------------------------------------------------------------------------------------------
+  // Cut selection
+  // --------------------------------------------------------------------------------------------
+
+  private boolean chooseCuts() {
+    List<Integer> cuts = new ArrayList<>();
+    List<List<Extra>> extras = new ArrayList<>();
+    int chunkStart = 0;
+    int size = 0;
+    int i = 0;
+    while (i < insnCount) {
+      size += conservativeSize(insns[i]);
+      if (size >= CHUNK_BUDGET && i + 1 < insnCount) {
+        int j = i + 1;
+        int scanSize = size;
+        List<Extra> cutExtras = null;
+        while (j < insnCount) {
+          if (validCut(j, chunkStart)) {
+            cutExtras = computeExtras(j);
+            if (cutExtras != null) {
+              break;
+            }
+          }
+          scanSize += conservativeSize(insns[j]);
+          if (scanSize > MAX_CODE_SIZE) {
+            return false; // no valid cut before the hard limit — cannot guarantee chunk fits
+          }
+          j++;
+        }
+        if (j >= insnCount) {
+          break; // remainder stays as the final chunk (already overflow-checked above)
+        }
+        cuts.add(j);
+        extras.add(cutExtras);
+        chunkStart = j;
+        size = 0;
+        i = j;
+        continue;
+      }
+      i++;
+    }
+    if (cuts.isEmpty()) {
+      return false;
+    }
+    boundaries = new int[cuts.size() + 2];
+    boundaries[0] = 0;
+    for (int k = 0; k < cuts.size(); k++) {
+      boundaries[k + 1] = cuts.get(k);
+    }
+    boundaries[cuts.size() + 1] = insnCount;
+    extrasPerChunk = new ArrayList<>(cuts.size() + 1);
+    extrasPerChunk.add(List.of()); // chunk 0: original signature only
+    extrasPerChunk.addAll(extras);
+    return true;
+  }
+
+  private boolean validCut(int j, int chunkStart) {
+    if (j <= chunkStart || j >= insnCount || noCut.get(j)) {
+      return false;
+    }
+    Frame<DescriptorInterpreter.DV> frame = frames[j];
+    if (frame == null || frame.getStackSize() != 0) {
+      return false; // unreachable, or mid-expression (operand stack not empty)
+    }
+    return true;
+  }
+
+  /**
+   * Live non-parameter slots at the cut, with their types — or {@code null} if any slot cannot be
+   * typed unambiguously (mixed sources, null constants, unknown producers): the cut is then
+   * rejected rather than guessed.
+   */
+  private List<Extra> computeExtras(int cut) {
+    // Note: no early return when a param slot is live — the first live slot being a param says
+    // nothing about other live slots; non-param locals must still be collected below (dropping
+    // them would emit chunks whose signatures miss live state → VerifyError or silent
+    // miscompilation).
+    BitSet live = liveIn[cut];
+    List<Extra> result = new ArrayList<>();
+    for (int s = live.nextSetBit(paramSlots); s >= 0; s = live.nextSetBit(s + 1)) {
+      String desc = typeOfSlotAt(cut, s);
+      if (desc == null) {
+        return null;
+      }
+      result.add(new Extra(s, desc));
+    }
+    int slots = (isStatic ? 0 : 1);
+    for (Type t : paramTypes) {
+      slots += t.getSize();
+    }
+    for (Extra e : result) {
+      slots += Type.getType(e.desc()).getSize();
+    }
+    if (slots > MAX_PARAM_SLOTS) {
+      return null;
+    }
+    return result;
+  }
+
+  /** Descriptor of the value in local slot {@code slot} at the cut, or null if untypeable. */
+  private String typeOfSlotAt(int cut, int slot) {
+    Frame<DescriptorInterpreter.DV> frame = frames[cut];
+    DescriptorInterpreter.DV value = frame.getLocal(slot);
+    return value == null ? null : value.desc;
+  }
+
+  // --------------------------------------------------------------------------------------------
+  // Chunk validation (before any emission)
+  // --------------------------------------------------------------------------------------------
+
+  private boolean validateChunks() {
+    // Try regions and handlers must each live inside a single chunk.
+    if (node.tryCatchBlocks != null) {
+      for (TryCatchBlockNode tcb : node.tryCatchBlocks) {
+        int start = labelIndex.get(tcb.start);
+        int end = labelIndex.get(tcb.end);
+        int handler = labelIndex.get(tcb.handler);
+        if (chunkOf(start) != chunkOf(end - 1) || chunkOf(start) != chunkOf(handler)) {
+          return false;
+        }
+      }
+    }
+    // Each chunk, including the chaining call sequences it adds, must conservatively fit.
+    for (int k = 0; k + 1 < boundaries.length; k++) {
+      int size = 0;
+      for (int i = boundaries[k]; i < boundaries[k + 1]; i++) {
+        size += conservativeSize(insns[i]);
+      }
+      if (k + 2 < boundaries.length) { // non-final chunks end with a tail chain call
+        size += callSeqConservativeSize(boundaries[k + 1]);
+      }
+      if (size > MAX_CODE_SIZE) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private int callSeqConservativeSize(int entry) {
+    int slots = (isStatic ? 0 : 1);
+    for (Type t : paramTypes) {
+      slots += t.getSize();
+    }
+    List<Extra> extras = extrasAt(entry);
+    for (Extra e : extras) {
+      slots += Type.getType(e.desc()).getSize();
+    }
+    return 6 + 4 * slots + 4; // conservative loads + invoke + return
+  }
+
+  private int chunkOf(int index) {
+    int lo = 0;
+    int hi = boundaries.length - 1;
+    while (lo < hi) {
+      int mid = (lo + hi + 1) >>> 1;
+      if (boundaries[mid] <= index) {
+        lo = mid;
+      } else {
+        hi = mid - 1;
+      }
+    }
+    return lo;
+  }
+
+  private List<Extra> extrasAt(int entry) {
+    if (entry == 0) {
+      return List.of();
+    }
+    return extrasPerChunk.get(chunkOf(entry));
+  }
+
+  // --------------------------------------------------------------------------------------------
+  // Chunk emission
+  // --------------------------------------------------------------------------------------------
+
+  private void emitChunks(MethodVisitor chunk0) {
+    for (int k = 0; k + 1 < boundaries.length; k++) {
+      int start = boundaries[k];
+      int end = boundaries[k + 1];
+      List<Extra> extras = extrasPerChunk.get(k);
+      MethodVisitor mv;
+      if (k == 0) {
+        mv = chunk0;
+        replayMetadata(chunk0);
+      } else {
+        int access = ACC_PRIVATE | ACC_SYNTHETIC | (isStatic ? ACC_STATIC : 0);
+        mv =
+            realWriter.visitMethod(
+                access,
+                chunkName(k),
+                chunkDescriptor(extras),
+                null,
+                node.exceptions == null ? null : node.exceptions.toArray(new String[0]));
+      }
+      emitChunkBody(mv, k, start, end, extras);
+    }
+  }
+
+  private void replayMetadata(MethodVisitor mv) {
+    if (node.visibleAnnotations != null) {
+      for (var ann : node.visibleAnnotations) {
+        ann.accept(mv.visitAnnotation(ann.desc, true));
+      }
+    }
+    if (node.invisibleAnnotations != null) {
+      for (var ann : node.invisibleAnnotations) {
+        ann.accept(mv.visitAnnotation(ann.desc, false));
+      }
+    }
+    if (node.visibleTypeAnnotations != null) {
+      for (var ann : node.visibleTypeAnnotations) {
+        ann.accept(mv.visitTypeAnnotation(ann.typeRef, ann.typePath, ann.desc, true));
+      }
+    }
+    if (node.invisibleTypeAnnotations != null) {
+      for (var ann : node.invisibleTypeAnnotations) {
+        ann.accept(mv.visitTypeAnnotation(ann.typeRef, ann.typePath, ann.desc, false));
+      }
+    }
+    if (node.attrs != null) {
+      for (var attr : node.attrs) {
+        mv.visitAttribute(attr);
+      }
+    }
+  }
+
+  private void emitChunkBody(
+      MethodVisitor mv, int chunkIdx, int start, int end, List<Extra> extras) {
+    int[] slotMap = buildSlotMap(extras);
+    IdentityHashMap<LabelNode, Label> labels = new IdentityHashMap<>();
+    List<LocalCross> crossingBlocks = new ArrayList<>();
+    mv.visitCode();
+    if (node.tryCatchBlocks != null) {
+      for (TryCatchBlockNode tcb : node.tryCatchBlocks) {
+        int s = labelIndex.get(tcb.start);
+        int e = labelIndex.get(tcb.end);
+        int h = labelIndex.get(tcb.handler);
+        if (s >= start && e <= end && h >= start && h < end) {
+          mv.visitTryCatchBlock(
+              freshLabel(labels, tcb.start),
+              freshLabel(labels, tcb.end),
+              freshLabel(labels, tcb.handler),
+              tcb.type);
+        }
+      }
+    }
+    for (int i = start; i < end; i++) {
+      emitInsnWithCrossing(mv, insns[i], labels, slotMap, end, crossingBlocks);
+    }
+    if (end < insnCount && hasFallthrough(start, end)) {
+      emitChunkCall(mv, end, slotMap);
+    }
+    for (LocalCross cross : crossingBlocks) {
+      mv.visitLabel(cross.localLabel());
+      emitChunkCall(mv, cross.targetEntry(), slotMap);
+    }
+    int extraSlots = 0;
+    for (Extra e : extras) {
+      extraSlots += Type.getType(e.desc()).getSize();
+    }
+    int chunkMaxLocals = paramSlots + extraSlots + (maxLocals - paramSlots);
+    mv.visitMaxs(node.maxStack + paramSlots + extraSlots + 2, chunkMaxLocals);
+    mv.visitEnd();
+  }
+
+  /**
+   * Maps original local slot indices to chunk-local slots: parameters keep their identity,
+   * entry-cut live slots become trailing parameters, everything else shifts past the parameters.
+   */
+  private int[] buildSlotMap(List<Extra> extras) {
+    int[] map = new int[maxLocals];
+    for (int s = 0; s < Math.min(paramSlots, maxLocals); s++) {
+      map[s] = s;
+    }
+    int pos = paramSlots;
+    for (Extra e : extras) {
+      map[e.slot()] = pos;
+      pos += Type.getType(e.desc()).getSize();
+    }
+    int extraSlots = pos - paramSlots;
+    for (int s = paramSlots; s < maxLocals; s++) {
+      boolean isExtra = false;
+      for (Extra e : extras) {
+        if (e.slot() == s) {
+          isExtra = true;
+          break;
+        }
+      }
+      if (!isExtra) {
+        map[s] = paramSlots + extraSlots + (s - paramSlots);
+      }
+    }
+    return map;
+  }
+
+  private boolean hasFallthrough(int start, int end) {
+    for (int i = end - 1; i >= start; i--) {
+      AbstractInsnNode insn = insns[i];
+      if (insn instanceof LabelNode
+          || insn instanceof LineNumberNode
+          || insn instanceof FrameNode) {
+        continue;
+      }
+      int op = insn.getOpcode();
+      return !((op >= IRETURN && op <= RETURN)
+          || op == ATHROW
+          || op == GOTO
+          || op == TABLESWITCH
+          || op == LOOKUPSWITCH);
+    }
+    return true; // chunk consists only of pseudo-instructions
+  }
+
+  private void emitChunkCall(MethodVisitor mv, int entry, int[] callerSlotMap) {
+    List<Extra> extras = extrasAt(entry);
+    if (!isStatic) {
+      mv.visitVarInsn(ALOAD, 0);
+    }
+    int slot = isStatic ? 0 : 1;
+    for (Type t : paramTypes) {
+      loadByDesc(mv, t.getDescriptor(), callerSlotMap[slot]);
+      slot += t.getSize();
+    }
+    for (Extra e : extras) {
+      loadByDesc(mv, e.desc(), callerSlotMap[e.slot()]);
+    }
+    mv.visitMethodInsn(
+        isStatic ? INVOKESTATIC : INVOKESPECIAL,
+        className,
+        chunkName(chunkOf(entry)),
+        chunkDescriptor(extras),
+        false);
+    returnByDesc(mv, returnDesc);
+  }
+
+  private static void loadByDesc(MethodVisitor mv, String desc, int slot) {
+    char c = desc.charAt(0);
+    switch (c) {
+      case 'I', 'Z', 'B', 'C', 'S' -> mv.visitVarInsn(ILOAD, slot);
+      case 'J' -> mv.visitVarInsn(LLOAD, slot);
+      case 'F' -> mv.visitVarInsn(FLOAD, slot);
+      case 'D' -> mv.visitVarInsn(DLOAD, slot);
+      default -> mv.visitVarInsn(ALOAD, slot);
+    }
+  }
+
+  private static void returnByDesc(MethodVisitor mv, String desc) {
+    switch (desc.charAt(0)) {
+      case 'V' -> mv.visitInsn(RETURN);
+      case 'I', 'Z', 'B', 'C', 'S' -> mv.visitInsn(IRETURN);
+      case 'J' -> mv.visitInsn(LRETURN);
+      case 'F' -> mv.visitInsn(FRETURN);
+      case 'D' -> mv.visitInsn(DRETURN);
+      default -> mv.visitInsn(ARETURN);
+    }
+  }
+
+  private String chunkName(int chunkIdx) {
+    return chunkIdx == 0 ? node.name : node.name + "$s" + chunkIdx;
+  }
+
+  private String chunkDescriptor(List<Extra> extras) {
+    StringBuilder sb = new StringBuilder("(");
+    for (Type t : paramTypes) {
+      sb.append(t.getDescriptor());
+    }
+    for (Extra e : extras) {
+      sb.append(e.desc());
+    }
+    return sb.append(')').append(returnDesc).toString();
+  }
+
+  private void emitInsnWithCrossing(
+      MethodVisitor mv,
+      AbstractInsnNode insn,
+      IdentityHashMap<LabelNode, Label> labels,
+      int[] slotMap,
+      int end,
+      List<LocalCross> crossingBlocks) {
+    if (insn instanceof LabelNode label) {
+      mv.visitLabel(freshLabel(labels, label));
+      return;
+    }
+    if (insn instanceof LineNumberNode line) {
+      mv.visitLineNumber(line.line, freshLabel(labels, line.start));
+      return;
+    }
+    if (insn instanceof FrameNode) {
+      return; // recomputed by COMPUTE_FRAMES
+    }
+    int op = insn.getOpcode();
+    if (insn instanceof JumpInsnNode jump) {
+      int target = labelIndex.get(jump.label);
+      if (target < end) {
+        mv.visitJumpInsn(op, freshLabel(labels, jump.label));
+      } else {
+        // Forward jump into a later chunk's entry: allowed only for chunk entries.
+        if (chunkOf(target) <= chunkOf(end - 1) || !isChunkEntry(target)) {
+          throw new IllegalStateException(
+              "splitter invariant violated: jump to interior of later chunk");
+        }
+        if (op == GOTO) {
+          emitChunkCall(mv, target, slotMap); // unconditional: call chain inline
+        } else {
+          Label local = new Label();
+          crossingBlocks.add(new LocalCross(local, target));
+          mv.visitJumpInsn(op, local); // conditional: taken edge defers to end-of-chunk block
+        }
+      }
+      return;
+    }
+    if (insn instanceof TableSwitchInsnNode sw) {
+      Label dflt = switchTarget(sw.dflt, end, labels, crossingBlocks);
+      Label[] cases = new Label[sw.labels.size()];
+      for (int k = 0; k < cases.length; k++) {
+        cases[k] = switchTarget(sw.labels.get(k), end, labels, crossingBlocks);
+      }
+      mv.visitTableSwitchInsn(sw.min, sw.max, dflt, cases);
+      return;
+    }
+    if (insn instanceof LookupSwitchInsnNode sw) {
+      Label dflt = switchTarget(sw.dflt, end, labels, crossingBlocks);
+      Label[] cases = new Label[sw.labels.size()];
+      int[] keys = new int[sw.keys.size()];
+      for (int k = 0; k < cases.length; k++) {
+        cases[k] = switchTarget(sw.labels.get(k), end, labels, crossingBlocks);
+        keys[k] = sw.keys.get(k);
+      }
+      mv.visitLookupSwitchInsn(dflt, keys, cases);
+      return;
+    }
+    emitInsn(mv, insn, labels, slotMap);
+  }
+
+  private Label switchTarget(
+      LabelNode target,
+      int end,
+      IdentityHashMap<LabelNode, Label> labels,
+      List<LocalCross> crossingBlocks) {
+    int t = labelIndex.get(target);
+    if (t < end) {
+      return freshLabel(labels, target);
+    }
+    if (!isChunkEntry(t)) {
+      throw new IllegalStateException(
+          "splitter invariant violated: switch case to interior of later chunk");
+    }
+    Label local = new Label();
+    crossingBlocks.add(new LocalCross(local, t));
+    return local;
+  }
+
+  private boolean isChunkEntry(int index) {
+    for (int b : boundaries) {
+      if (b == index) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static final int[] IDENTITY_SLOT_MAP = new int[0]; // identity mapping marker
+
+  private static void emitInsn(
+      MethodVisitor mv,
+      AbstractInsnNode insn,
+      IdentityHashMap<LabelNode, Label> labels,
+      int[] slotMap) {
+    if (insn instanceof LabelNode label) {
+      mv.visitLabel(freshLabel(labels, label));
+      return;
+    }
+    if (insn instanceof LineNumberNode line) {
+      mv.visitLineNumber(line.line, freshLabel(labels, line.start));
+      return;
+    }
+    if (insn instanceof FrameNode) {
+      return;
+    }
+    int op = insn.getOpcode();
+    if (insn instanceof InsnNode) {
+      mv.visitInsn(op);
+    } else if (insn instanceof IntInsnNode i) {
+      mv.visitIntInsn(op, i.operand);
+    } else if (insn instanceof VarInsnNode v) {
+      mv.visitVarInsn(op, remapSlot(slotMap, v.var));
+    } else if (insn instanceof TypeInsnNode t) {
+      mv.visitTypeInsn(op, t.desc);
+    } else if (insn instanceof FieldInsnNode f) {
+      mv.visitFieldInsn(op, f.owner, f.name, f.desc);
+    } else if (insn instanceof MethodInsnNode m) {
+      mv.visitMethodInsn(op, m.owner, m.name, m.desc, m.itf);
+    } else if (insn instanceof InvokeDynamicInsnNode d) {
+      mv.visitInvokeDynamicInsn(d.name, d.desc, d.bsm, d.bsmArgs);
+    } else if (insn instanceof LdcInsnNode ldc) {
+      if (ldc.cst instanceof Integer value) {
+        BytecodeUtil.pushInt(mv, value); // repo convention: never ldc a primitive int
+      } else {
+        mv.visitLdcInsn(ldc.cst);
+      }
+    } else if (insn instanceof IincInsnNode inc) {
+      mv.visitIincInsn(remapSlot(slotMap, inc.var), inc.incr);
+    } else if (insn instanceof JumpInsnNode j) {
+      mv.visitJumpInsn(op, freshLabel(labels, j.label));
+    } else if (insn instanceof MultiANewArrayInsnNode m) {
+      mv.visitMultiANewArrayInsn(m.desc, m.dims);
+    }
+  }
+
+  private static int remapSlot(int[] slotMap, int slot) {
+    return slotMap.length == 0 ? slot : slotMap[slot];
+  }
+
+  private static Label freshLabel(IdentityHashMap<LabelNode, Label> labels, LabelNode labelNode) {
+    Label label = labels.get(labelNode);
+    if (label == null) {
+      label = new Label();
+      labels.put(labelNode, label);
+    }
+    return label;
+  }
+}
